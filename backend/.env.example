# Email alerts (optional — required for critical offline notifications)
ALERT_EMAIL_TO=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
SMTP_USE_TLS=true
ALERT_EMAIL_ENABLED=true

# ── Nmap Scanner ──────────────────────────────────────────────────────────────
# Interval (seconds) between automatic Nmap scans (default: 3600 = 1 hour)
NMAP_SCAN_INTERVAL=3600

# Nmap CLI arguments. Use -sV -T4 when running without root/administrator.
# Full aggressive scan (requires elevated privileges):
NMAP_ARGUMENTS=-A -T4

# Maximum concurrent Nmap scans (keep low to avoid network congestion)
MAX_SCAN_THREADS=5

# Per-host Nmap timeout in seconds
NMAP_TIMEOUT=300

# Full path to nmap binary. Leave empty to auto-detect from system PATH.
# Windows example: C:\Program Files (x86)\Nmap\nmap.exe
NMAP_PATH=

# ── Interface Discovery (SSH) ─────────────────────────────────────────────────
# Interval (seconds) between automatic interface discovery runs (default: 3600).
# Set to 0 to disable the scheduled job (manual POST /api/interfaces/discover* still works).
INTERFACE_SCAN_INTERVAL=3600

# Max concurrent SSH sessions for interface discovery
MAX_INTERFACE_THREADS=5

# Default SSH credentials used when a device has no per-device credentials object.
# Prefer setting credentials on each switch via PUT /api/devices/<id>.
SSH_DEFAULT_USERNAME=
SSH_DEFAULT_PASSWORD=
SSH_DEFAULT_PORT=22
SSH_DEFAULT_SECRET=
SSH_DEFAULT_VENDOR=cisco_ios
SSH_TIMEOUT=30

# ── Interface Statistics ──────────────────────────────────────────────────────
# Poll interval (seconds) for interface counters. Default: 60. Set 0 to disable.
INTERFACE_STATS_INTERVAL=60

# Max concurrent device polls for interface statistics
MAX_INTERFACE_STATS_THREADS=8

# Bulk insert chunk size for historical samples
INTERFACE_STATS_BATCH_SIZE=500

# SNMP defaults (preferred transport for stats; SSH used when SNMP fails)
SNMP_DEFAULT_COMMUNITY=public
SNMP_DEFAULT_VERSION=2c
SNMP_DEFAULT_PORT=161
SNMP_TIMEOUT=3
SNMP_RETRIES=1

# ── Storm Protection — Port Eligibility Engine ────────────────────────────────
# Master switch for scheduled + bulk eligibility evaluation.
STORM_ENABLE_ELIGIBILITY=true

# Policy overrides (default: deny). When true, the matching rule is skipped.
STORM_ALLOW_MANAGEMENT_PORTS=false
STORM_ALLOW_TRUNKS=false
STORM_ALLOW_INFRASTRUCTURE_PORTS=false
STORM_ALLOW_PROTECTED_PORTS=false

# Confidence score returned with every eligibility decision (0–100).
STORM_ELIGIBILITY_CONFIDENCE=100
