# Email alerts (optional — required for critical offline notifications)
ALERT_EMAIL_TO=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
SMTP_USE_TLS=true
ALERT_EMAIL_ENABLED=true

# ── Nmap Scanner ──────────────────────────────────────────────────────────────
# Interval (seconds) between automatic Nmap scans (default: 3600 = 1 hour)
NMAP_SCAN_INTERVAL=3600

# Nmap CLI arguments. Use -sV -T4 when running without root/administrator.
# Full aggressive scan (requires elevated privileges):
NMAP_ARGUMENTS=-A -T4

# Maximum concurrent Nmap scans (keep low to avoid network congestion)
MAX_SCAN_THREADS=5

# Per-host Nmap timeout in seconds
NMAP_TIMEOUT=300

# Full path to nmap binary. Leave empty to auto-detect from system PATH.
# Windows example: C:\Program Files (x86)\Nmap\nmap.exe
NMAP_PATH=

# ── Interface Discovery (SSH) ─────────────────────────────────────────────────
# Interval (seconds) between automatic interface discovery runs (default: 3600).
# Set to 0 to disable the scheduled job (manual POST /api/interfaces/discover* still works).
INTERFACE_SCAN_INTERVAL=3600

# Max concurrent SSH sessions for interface discovery
MAX_INTERFACE_THREADS=5

# Default SSH credentials used when a device has no per-device credentials object.
# Prefer setting credentials on each switch via PUT /api/devices/<id>.
SSH_DEFAULT_USERNAME=
SSH_DEFAULT_PASSWORD=
SSH_DEFAULT_PORT=22
SSH_DEFAULT_SECRET=
SSH_DEFAULT_VENDOR=cisco_ios
SSH_TIMEOUT=30

# ── Interface Statistics ──────────────────────────────────────────────────────
# Poll interval (seconds) for interface counters. Default: 60. Set 0 to disable.
INTERFACE_STATS_INTERVAL=60

# Max concurrent device polls for interface statistics
MAX_INTERFACE_STATS_THREADS=8

# Bulk insert chunk size for historical samples
INTERFACE_STATS_BATCH_SIZE=500

# SNMP defaults (preferred transport for stats; SSH used when SNMP fails)
SNMP_DEFAULT_COMMUNITY=public
SNMP_DEFAULT_VERSION=2c
SNMP_DEFAULT_PORT=161
SNMP_TIMEOUT=3
SNMP_RETRIES=1

# ── Storm Protection — Port Eligibility Engine ────────────────────────────────
# Master switch for scheduled + bulk eligibility evaluation.
STORM_ENABLE_ELIGIBILITY=true

# Policy overrides (default: deny). When true, the matching rule is skipped.
STORM_ALLOW_MANAGEMENT_PORTS=false
STORM_ALLOW_TRUNKS=false
STORM_ALLOW_INFRASTRUCTURE_PORTS=false
STORM_ALLOW_PROTECTED_PORTS=false

# Confidence score returned with every eligibility decision (0–100).
STORM_ELIGIBILITY_CONFIDENCE=100

# ── Storm Protection — Risk Score Engine ──────────────────────────────────────
STORM_ENABLE_RISK=true

# Metric weights (must sum conceptually to 100; unsupported metrics are ignored)
STORM_WEIGHT_BROADCAST=35
STORM_WEIGHT_MULTICAST=15
STORM_WEIGHT_UNKNOWN_UNICAST=15
STORM_WEIGHT_UTILIZATION=10
STORM_WEIGHT_ERRORS=10
STORM_WEIGHT_DISCARDS=5
STORM_WEIGHT_CRC=5

# Rate thresholds: LOW / MEDIUM / HIGH / CRITICAL band edges
STORM_THRESH_BROADCAST_LOW=50
STORM_THRESH_BROADCAST_MEDIUM=200
STORM_THRESH_BROADCAST_HIGH=1000
STORM_THRESH_BROADCAST_CRITICAL=5000

STORM_THRESH_MULTICAST_LOW=100
STORM_THRESH_MULTICAST_MEDIUM=500
STORM_THRESH_MULTICAST_HIGH=2000
STORM_THRESH_MULTICAST_CRITICAL=8000

STORM_THRESH_UNKNOWN_UNICAST_LOW=50
STORM_THRESH_UNKNOWN_UNICAST_MEDIUM=200
STORM_THRESH_UNKNOWN_UNICAST_HIGH=1000
STORM_THRESH_UNKNOWN_UNICAST_CRITICAL=5000

STORM_THRESH_UTILIZATION_LOW=30
STORM_THRESH_UTILIZATION_MEDIUM=50
STORM_THRESH_UTILIZATION_HIGH=75
STORM_THRESH_UTILIZATION_CRITICAL=90

STORM_THRESH_ERRORS_LOW=1
STORM_THRESH_ERRORS_MEDIUM=5
STORM_THRESH_ERRORS_HIGH=20
STORM_THRESH_ERRORS_CRITICAL=50

STORM_THRESH_DISCARDS_LOW=1
STORM_THRESH_DISCARDS_MEDIUM=10
STORM_THRESH_DISCARDS_HIGH=50
STORM_THRESH_DISCARDS_CRITICAL=200

STORM_THRESH_CRC_LOW=1
STORM_THRESH_CRC_MEDIUM=5
STORM_THRESH_CRC_HIGH=20
STORM_THRESH_CRC_CRITICAL=50

# ── Storm Protection — Confirmation Engine ────────────────────────────────────
# Persist high-risk across N polling cycles before confirming a storm.
STORM_CONFIRMATION_ENABLED=true
STORM_REQUIRED_CONFIRMATIONS=4
STORM_CONFIRMATION_RISK_THRESHOLD=75
STORM_CONFIRMATION_RESET_ON_POLL_FAILURE=true
STORM_CONFIRMATION_RESET_ON_INELIGIBLE=true
STORM_CONFIRMATION_RESET_ON_LOW_RISK=true
# Treat stats older than this as a polling failure (seconds).
STORM_CONFIRMATION_POLL_STALE_SECONDS=180

# ── Storm Protection — Safety Engine ──────────────────────────────────────────
STORM_SAFETY_ENABLED=true
STORM_AUTOMATION_ENABLED=true
STORM_COOLDOWN_MINUTES=30
STORM_CPU_THRESHOLD=90
STORM_MEMORY_THRESHOLD=90
STORM_MAXIMUM_ATTEMPTS=3
STORM_ALLOW_MANUAL_OVERRIDE=false
STORM_SAFETY_RISK_THRESHOLD=75
STORM_SAFETY_REQUIRE_SSH=true
STORM_SAFETY_FAIL_OPEN_MISSING_HEALTH=true
STORM_SAFETY_SSH_TIMEOUT=15
