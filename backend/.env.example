# Flask runtime (default: debug OFF). Never enable debug on a shared/network host.
FLASK_DEBUG=false

# Production deployment role:
#   all       — single process (API + scheduler)
#   api       — HTTP only; pair with run_scheduler.py
#   scheduler — scheduler only (run_scheduler.py)
NETPULSE_ROLE=all
# true | false | auto — auto disables scheduler when GUNICORN_WORKERS>1
NETPULSE_ENABLE_SCHEDULER=auto
# REQUIRED for production posture (unset + FLASK_DEBUG=false also defaults to production).
NETPULSE_ENV=production

# CORS — REQUIRED in production (comma-separated, no wildcards with credentials).
# CORS_ALLOWED_ORIGINS=https://netpulse.example.com

# Bind (prefer localhost behind HTTPS reverse proxy).
# FLASK_RUN_HOST=127.0.0.1
# GUNICORN_BIND=127.0.0.1:5000

# Request / CSV upload limits (bytes).
# MAX_CONTENT_LENGTH=2097152
# MAX_CSV_UPLOAD_BYTES=1048576

# Login brute-force protection
# LOGIN_MAX_FAILURES=8
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900

# SSH host-key verification (production uses RejectPolicy).
# SSH_KNOWN_HOSTS_FILE=known_hosts
# Local lab only (requires FLASK_DEBUG=true):
# SSH_ALLOW_UNKNOWN_HOSTS=false

# ── MongoDB ──────────────────────────────────────────────────────────────────
# MONGO_URI=mongodb://127.0.0.1:27017
# DATABASE_NAME=NetworkMonitor
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=0
# MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_CONNECT_TIMEOUT_MS=20000
# MONGO_SOCKET_TIMEOUT_MS=20000
# MONGO_RETRY_WRITES=true
# MONGO_RETRY_READS=true

# ── Storm auto-mitigation batching (when mitigationMode=automatic) ───────────
# STORM_MITIGATION_BATCH_SIZE=5

# ── Global SSH collector concurrency (mitigation uses priority path) ────────
# MAX_GLOBAL_SSH_SESSIONS=10
# SSH_SLOT_WAIT_SECONDS=30

# JWT signing secret — REQUIRED when FLASK_DEBUG is false.
# Must be >= 32 chars and not a placeholder. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Bootstrap passwords — REQUIRED for empty DB in production (min 12 chars,
# not well-known defaults like admin123). Existing users are never modified.
# DEFAULT_ADMIN_USER=admin
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_USER_NAME=user
# DEFAULT_USER_PASSWORD=
# DEFAULT_VIEWER_PASSWORD=  # legacy alias for DEFAULT_USER_PASSWORD

# Fernet key for SSH/SMTP/SNMP secrets at rest — REQUIRED when FLASK_DEBUG is false.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable; rotating it without re-encrypting secrets will break decrypt.
SECRETS_ENCRYPTION_KEY=

# How long to keep ping/stats/storm evaluation history (days). Default 90. Min 7.
# Applied via MongoDB TTL indexes.
DATA_RETENTION_DAYS=90

# ── Ping monitoring hardening ─────────────────────────────────────────────────
# Runtime mode for the device ping monitor.
#   dispatch — nextCheckAt + atomic claim + bounded workers (DEFAULT).
#   legacy   — APScheduler wave / monitor_all_devices (compat / rollback).
# Unknown values fall back to dispatch.
MONITOR_RUNTIME_MODE=dispatch

# Dispatch-mode only: APScheduler period for the due-device dispatcher.
# Independent of pingInterval (device cadence). Default 5, clamped 1–15.
# PUT /settings pingInterval does NOT retarget this period; use process
# restart or scheduler.reschedule_dispatcher_job() after changing this env.
MONITOR_DISPATCHER_INTERVAL_SECONDS=5

# Optional claim TTL floor (seconds). When set, claim TTL is
# max(computed_from_timeout_retries, PING_CLAIM_TTL). Leave unset to use
# the computed value only: max(15, (timeout_ms/1000)*retries + 10).
# PING_CLAIM_TTL=30

# MongoDB leader-election lease for scheduled jobs (seconds). Renewed during
# long cycles. Another instance steals the lease after expiry. Default: 90.
SCHEDULER_LOCK_TTL_SECONDS=90

# Optional ICMP probe host for collector partition detection (Phase 8).
# When this probe fails, mass offline transitions are suppressed for the cycle
# (device status is NOT rewritten to Not Reachable / Offline).
# When the probe succeeds (or is empty/disabled), genuine single-device failures
# are never suppressed. The probe itself never writes devices.status.
# Leave empty to disable. Examples: default gateway, or a always-on mgmt host.
MONITOR_CONNECTIVITY_PROBE_HOST=
MONITOR_CONNECTIVITY_PROBE_TIMEOUT_MS=800

# Ping defaults (seeded into Mongo settings on first boot; runtime SoT is Mongo).
# Changing these env vars later does NOT rewrite an existing settings document
# (except the one-time cadence migration: pingInterval 30→60 and
# pingConcurrency 20|30→40 when those exact legacy seeds are still present).
# SCAN_INTERVAL — per-device monitoring cadence seconds (target 60; min 5 via API).
# PING_TIMEOUT_MS — per-ICMP-attempt timeout in milliseconds (min 100).
# PING_RETRIES — TOTAL ICMP attempts per scan (not "retries after the first").
#   Example: PING_RETRIES=3 → up to 3 sequential pings; success on any ends the scan.
# PING_FAILURE_CONFIRMATION_SCANS — complete failed SCANS before Online leaves
#   to Not Reachable / Offline (Critical). Separate from critical alert threshold (3).
# MONITOR_PING_CONCURRENCY — max parallel ping workers (1–64, default 40; band 25–40).
#   With 500 hosts @ 60s cadence, concurrency 40 keeps worst-case timeout waves
#   (1000ms × 3 attempts ≈ 3s/device) inside the interval with headroom.
# Do not raise PING_TIMEOUT_MS here without measuring your network; 1000 is the seed.
# IMPORTANT: If Mongo already has pingTimeoutMs=3000, update Settings/API — .env alone
# will not rewrite it.
SCAN_INTERVAL=60
PING_TIMEOUT_MS=1000
PING_RETRIES=3
PING_FAILURE_CONFIRMATION_SCANS=2
MONITOR_PING_CONCURRENCY=40

# How long to keep mitigation/recovery attempt logs AND closed (RESOLVED)
# storm_incidents (days). Default 365. Min 30. Daily purge uses this window.
INCIDENT_RETENTION_DAYS=365

# ── Email alerts (optional — required for critical offline notifications) ──────
#
# EMAIL_PROVIDER selects the SMTP provider used to SEND alerts.
# Supported values: gmail | outlook  (also accepted: microsoft365, office365)
# The recipient address (ALERT_EMAIL_TO) is independent of the provider —
# any valid email address can receive alerts regardless of sender provider.
#
# Backward-compatibility: if EMAIL_PROVIDER is absent, gmail is assumed
# (unless SMTP_HOST already points at an Outlook server).
EMAIL_PROVIDER=gmail

# ── Gmail configuration ───────────────────────────────────────────────────────
# Use a Gmail App Password (not your account password).
# Create one at: https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#
# ── Outlook / Microsoft 365 configuration ────────────────────────────────────
# Requires SMTP AUTH to be enabled for the account/tenant.
# Tenant admins: Enable via Exchange Admin Center > Settings > Mail flow.
#   EMAIL_PROVIDER=outlook
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#
# All four combinations work:
#   Gmail sender   → Gmail recipient
#   Gmail sender   → Outlook recipient
#   Outlook sender → Gmail recipient
#   Outlook sender → Outlook recipient
# ─────────────────────────────────────────────────────────────────────────────
ALERT_EMAIL_TO=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=NetPulse
SMTP_USE_TLS=true
ALERT_EMAIL_ENABLED=true

# ── Nmap Scanner ──────────────────────────────────────────────────────────────
# Interval (seconds) between automatic Nmap scans (default: 3600 = 1 hour)
NMAP_SCAN_INTERVAL=3600

# Deep / diagnostic profile (manual Scan Details / admin bulk deep scan).
# Use -sV -T4 when running without root/administrator.
# Full aggressive scan (requires elevated privileges):
NMAP_ARGUMENTS=-A -T4

# Quick / inventory profile (network discovery + scheduled inventory).
# OS + version detection, top ports — no NSE scripts / traceroute.
# Validated at startup; must be a safe Nmap flag string (see config/nmap_validation.py).
NMAP_QUICK_ARGUMENTS=-O -sV -T4 --top-ports 100

# Maximum concurrent Nmap scans (keep low to avoid network congestion)
MAX_SCAN_THREADS=5

# Per-host Nmap timeout in seconds
NMAP_TIMEOUT=300

# Reuse Nmap results when networkInfo.lastScan is younger than this (seconds).
# Set to 0 to disable TTL caching. Default: 21600 (6 hours).
NMAP_CACHE_TTL=21600

# Full path to nmap binary. Leave empty to auto-detect from system PATH.
# Windows example: C:\Program Files (x86)\Nmap\nmap.exe
NMAP_PATH=

# ── Interface Discovery (SSH) ─────────────────────────────────────────────────
# Interval (seconds) between automatic interface discovery runs (default: 3600).
# Set to 0 to disable the scheduled job (manual POST /api/interfaces/discover* still works).
INTERFACE_SCAN_INTERVAL=3600

# Max concurrent SSH sessions for interface discovery
MAX_INTERFACE_THREADS=5

# Default SSH credentials used when a device has no per-device credentials object.
# Prefer setting credentials on each switch via PUT /api/devices/<id>.
SSH_DEFAULT_USERNAME=
SSH_DEFAULT_PASSWORD=
SSH_DEFAULT_PORT=22
SSH_DEFAULT_SECRET=
SSH_DEFAULT_VENDOR=cisco_ios
SSH_TIMEOUT=30

# ── Interface Statistics ──────────────────────────────────────────────────────
# Poll interval (seconds) for interface counters. Default: 60. Set 0 to disable.
INTERFACE_STATS_INTERVAL=60

# Max concurrent device polls for interface statistics
MAX_INTERFACE_STATS_THREADS=8

# Bulk insert chunk size for historical samples
INTERFACE_STATS_BATCH_SIZE=500

# SNMP defaults (preferred transport for stats; SSH used when SNMP fails)
SNMP_DEFAULT_COMMUNITY=public
SNMP_DEFAULT_VERSION=2c
SNMP_DEFAULT_PORT=161
SNMP_TIMEOUT=3
SNMP_RETRIES=1

# ── Storm Protection — Port Eligibility Engine ────────────────────────────────
# Master switch for scheduled + bulk eligibility evaluation.
STORM_ENABLE_ELIGIBILITY=true

# Policy overrides (default: deny). When true, the matching rule is skipped.
STORM_ALLOW_MANAGEMENT_PORTS=false
STORM_ALLOW_TRUNKS=false
STORM_ALLOW_INFRASTRUCTURE_PORTS=false
STORM_ALLOW_PROTECTED_PORTS=false

# Confidence score returned with every eligibility decision (0–100).
STORM_ELIGIBILITY_CONFIDENCE=100

# ── Storm Protection — Risk Score Engine ──────────────────────────────────────
STORM_ENABLE_RISK=true

# Metric weights (must sum conceptually to 100; unsupported metrics are ignored)
STORM_WEIGHT_BROADCAST=35
STORM_WEIGHT_MULTICAST=15
STORM_WEIGHT_UNKNOWN_UNICAST=15
STORM_WEIGHT_UTILIZATION=10
STORM_WEIGHT_ERRORS=10
STORM_WEIGHT_DISCARDS=5
STORM_WEIGHT_CRC=5

# Rate thresholds: LOW / MEDIUM / HIGH / CRITICAL band edges
STORM_THRESH_BROADCAST_LOW=50
STORM_THRESH_BROADCAST_MEDIUM=200
STORM_THRESH_BROADCAST_HIGH=1000
STORM_THRESH_BROADCAST_CRITICAL=5000

STORM_THRESH_MULTICAST_LOW=100
STORM_THRESH_MULTICAST_MEDIUM=500
STORM_THRESH_MULTICAST_HIGH=2000
STORM_THRESH_MULTICAST_CRITICAL=8000

STORM_THRESH_UNKNOWN_UNICAST_LOW=50
STORM_THRESH_UNKNOWN_UNICAST_MEDIUM=200
STORM_THRESH_UNKNOWN_UNICAST_HIGH=1000
STORM_THRESH_UNKNOWN_UNICAST_CRITICAL=5000

STORM_THRESH_UTILIZATION_LOW=30
STORM_THRESH_UTILIZATION_MEDIUM=50
STORM_THRESH_UTILIZATION_HIGH=75
STORM_THRESH_UTILIZATION_CRITICAL=90

STORM_THRESH_ERRORS_LOW=1
STORM_THRESH_ERRORS_MEDIUM=5
STORM_THRESH_ERRORS_HIGH=20
STORM_THRESH_ERRORS_CRITICAL=50

STORM_THRESH_DISCARDS_LOW=1
STORM_THRESH_DISCARDS_MEDIUM=10
STORM_THRESH_DISCARDS_HIGH=50
STORM_THRESH_DISCARDS_CRITICAL=200

STORM_THRESH_CRC_LOW=1
STORM_THRESH_CRC_MEDIUM=5
STORM_THRESH_CRC_HIGH=20
STORM_THRESH_CRC_CRITICAL=50

# ── Storm Protection — Confirmation Engine ────────────────────────────────────
# Persist high-risk across N polling cycles before confirming a storm.
STORM_CONFIRMATION_ENABLED=true
STORM_REQUIRED_CONFIRMATIONS=2
STORM_CONFIRMATION_RISK_THRESHOLD=25
STORM_CONFIRMATION_RESET_ON_POLL_FAILURE=true
STORM_CONFIRMATION_RESET_ON_INELIGIBLE=true
STORM_CONFIRMATION_RESET_ON_LOW_RISK=true
# Treat stats older than this as a polling failure (seconds).
STORM_CONFIRMATION_POLL_STALE_SECONDS=180

# ── Storm Protection — Safety Engine ──────────────────────────────────────────
STORM_SAFETY_ENABLED=true
STORM_AUTOMATION_ENABLED=true
# Minutes after a successful mitigation before another mitigation is allowed
# on the same interface. Safety passes alone do not start this timer.
STORM_COOLDOWN_MINUTES=5
STORM_CPU_THRESHOLD=90
STORM_MEMORY_THRESHOLD=90
STORM_MAXIMUM_ATTEMPTS=3
STORM_ALLOW_MANUAL_OVERRIDE=false
STORM_SAFETY_RISK_THRESHOLD=25
STORM_SAFETY_REQUIRE_SSH=true
STORM_SAFETY_FAIL_OPEN_MISSING_HEALTH=false
STORM_SAFETY_SSH_TIMEOUT=15

# ── Storm Protection — Recovery ───────────────────────────────────────────────
# Minutes to wait after successful mitigation before auto-recovery may run.
STORM_RECOVERY_COOLDOWN_MINUTES=5
# Risk score required to prepare mitigation / re-mitigate after recovery.
# Keep at or below STORM_CONFIRMATION_RISK_THRESHOLD so confirmed storms proceed.
STORM_RE_MITIGATION_THRESHOLD=25

# ── Storm Protection — Email Notifications ────────────────────────────────────
# Uses the same SMTP block above. Leave STORM_EMAIL_TO blank to use ALERT_EMAIL_TO.
STORM_EMAIL_ENABLED=true
STORM_EMAIL_SHUTDOWN=true
STORM_EMAIL_RECOVERY=true
STORM_EMAIL_FAILURE=true
STORM_EMAIL_TO=
